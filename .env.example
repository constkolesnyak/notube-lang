# Notion integration secret — https://www.notion.so/my-integrations
NOTION_API_KEY=

# The two Notion databases this syncs into, as the 32-hex id in the database URL.
# NOTION_CHANNELS_DB — "Channels": one row per channel / podcast
# NOTION_VIDEOS_DB  — "YT Videos Backup": one row per video
NOTION_CHANNELS_DB=
NOTION_VIDEOS_DB=

# YouTube Data API OAuth (ytu) — JSON one-liners. Optional: only needed for ytu backup.
# GOOGLE_CLIENT_SECRET_JSON — contents of the Google Cloud OAuth client_secret.json
# GOOGLE_TOKEN_JSON — cached OAuth token (auto-written after first auth)
GOOGLE_CLIENT_SECRET_JSON=
GOOGLE_TOKEN_JSON=

# InnerTube cookie source — all optional, default is Chrome on the local host.
# NOTUBE_BROWSER: which browser yt-dlp reads cookies from (chrome, chromium, brave, firefox…).
# NOTUBE_CHROME_PROFILE: custom Chrome/Chromium user-data-dir (e.g. an isolated profile on a headless host).
# NOTUBE_COOKIES_FILE: path to a Netscape cookies.txt; if set, takes priority over browser extraction.
#   Produce one with: yt-dlp --cookies-from-browser chrome --cookies notube-cookies.txt --simulate https://youtube.com
NOTUBE_BROWSER=
NOTUBE_CHROME_PROFILE=
NOTUBE_COOKIES_FILE=

# Pocket Casts account — the only access Pocket Casts offers is your login (no API key).
# Used to import your subscribed shows into Channels. Leave empty to skip that stage.
POCKETCASTS_EMAIL=
POCKETCASTS_PASSWORD=

# InnerTube account selection — optional. A browser profile with several Google logins
# is addressed by index; the client detects the right one from the OAuth channel.
# NOTUBE_YT_CHANNEL_ID: the UC… id of the channel that owns the playlists (skips the OAuth lookup).
# NOTUBE_YT_AUTHUSER: pin the X-Goog-AuthUser index (0, 1, …) if detection cannot run.
NOTUBE_YT_CHANNEL_ID=
NOTUBE_YT_AUTHUSER=

# Where notube.pocketcasts_order writes its dated snapshots (default: run/pocketcasts-backups).
NOTUBE_PC_BACKUP_ROOT=

# claude CLI used by notube.lang / notube.level / notube.pocketcasts_topics, if not on PATH.
NOTUBE_CLAUDE_BIN=

# System Chromium for notube.yt_session_refresh (no `playwright install` needed).
NOTUBE_CHROMIUM_BIN=
